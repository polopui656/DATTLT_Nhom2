# Chức năng sắp xếp thuật toán
def start_sorting():
    global sort_thread1, sort_thread2, is_paused, is_stopped
    is_paused = False
    is_stopped = False
    selected_algo1 = algo_dropdown1.get()
    selected_algo2 = algo_dropdown2.get()

    sort_thread1 = threading.Thread(
        target=run_sorting_algorithm,
        args=(selected_algo1, data.copy(), chart_area1, time_label1),
    )
    sort_thread2 = threading.Thread(
        target=run_sorting_algorithm,
        args=(selected_algo2, data.copy(), chart_area2, time_label2),
    )

    sort_thread1.start()
    sort_thread2.start()


